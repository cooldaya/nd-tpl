{
  "name": "nd-tpl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "api": "pnpm ts-node --project tsconfig.node.json scripts/generate-api.ts",
    "crud": "pnpm ts-node --project tsconfig.node.json scripts/generate-crud.ts",
    "columns": "pnpm ts-node --project tsconfig.node.json scripts/generate-columns.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "crypto-es": "^3.1.3",
    "element-pro-components": "^1.4.1",
    "jsencrypt": "^3.5.4",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.23",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.5",
    "@iconify-json/ep": "^1.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/ejs": "^3.1.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.11.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "ejs": "^5.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "sass-embedded": "^1.98.0",
    "swagger-typescript-api": "^13.6.5",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "volta": {
    "node": "24.14.0"
  }
